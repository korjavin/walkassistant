# Google OAuth Configuration
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional: Set admin user (use the Google account email you want to be admin)
GOOGLE_ADMIN_ID=your-admin-email@gmail.com

# Cookie Security Keys
# Generate with: openssl rand -hex 64
COOKIE_HASH_KEY=generate_random_64_byte_key_here
# Generate with: openssl rand -hex 32
COOKIE_BLOCK_KEY=generate_random_32_byte_key_here

# Production settings
# GOOGLE_REDIRECT_URL=https://yourdomain.com/auth/google/callback
